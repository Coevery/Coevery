[project]
	description = A flexible data-centric web application framework
[access "refs/*"]
	owner = group user/Cao Xiangkun (caoxk)
[access "refs/for/refs/*"]
	read = group user/Cao Xiangkun (caoxk)
	push = group user/Cao Xiangkun (caoxk)
	label-Code-Review = -2..+2 group user/Cao Xiangkun (caoxk)
	label-Verified = -1..+1 group user/Cao Xiangkun (caoxk)
	rebase = group user/Cao Xiangkun (caoxk)
	removeReviewer = group user/Cao Xiangkun (caoxk)
	submit = group user/Cao Xiangkun (caoxk)
[access "refs/heads/*"]
	read = group user/Cao Xiangkun (caoxk)
	create = group user/Cao Xiangkun (caoxk)
	push = +force group user/Cao Xiangkun (caoxk)
	pushMerge = group user/Cao Xiangkun (caoxk)
[access "refs/tags/*"]
	push = +force group user/Cao Xiangkun (caoxk)
	pushTag = group user/Cao Xiangkun (caoxk)
	pushSignedTag = group user/Cao Xiangkun (caoxk)
